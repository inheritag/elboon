# Local-only. When true, skip Postgres / Resend and use a JSON
# (or in-memory) store. Card payments stay in-app either way.
DEV_MODE=true

# disk (default) writes to .data/dev-store.json; memory is wiped on restart
DEV_STORE=disk

# Production-like run: set DEV_MODE=false. Neon on Vercel often sets DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# Optional. New haggles always show in /admin/offers even without this.
RESEND_API_KEY=

# Optional in DEV_MODE (local defaults are used).
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Use SITE_URL on Vercel (PUBLIC_ cannot be a secret).
SITE_URL=http://localhost:5173
PUBLIC_SITE_URL=
