# Local-only. When true, skip Postgres and Resend and use a JSON store.
# With no STRIPE_API_KEY, the pay button places the order and does not charge.
DEV_MODE=true

# disk (default) writes to .data/dev-store.json; memory is wiped on restart
DEV_STORE=disk

# Production-like run: set DEV_MODE=false. Neon on Vercel often sets DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# Required in production for order, offer, and support mail.
# The from address is orders@elboon.com, so that domain must be verified in Resend.
# Without the key, a paid order stays unsent and can be retried. Dev mode records mail locally.
RESEND_API_KEY=

# Optional. Paid orders and new haggles are sent here. Defaults to elboonltd@gmail.com.
OFFERS_INBOX=elboonltd@gmail.com

# Server key: sk_live_, sk_test_, rk_live_, or rk_test_. A publishable pk_ key cannot take payment.
# An rk_ key needs Checkout Sessions set to Write.
STRIPE_API_KEY=

# Optional. Signing secret for POST /checkout/stripe (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=

# Optional. Books a paid order in Royal Mail Click & Drop. Postage is applied there.
ROYAL_MAIL_API_KEY=

# Optional in DEV_MODE (local defaults are used).
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Public site address for emails. Checkout on https uses the request address if this is unset.
SITE_URL=http://localhost:5173
PUBLIC_SITE_URL=
